# Server
NODE_ENV=development
PORT=5001

# Database — local docker (docker compose up -d) or an Atlas connection string
MONGODB_URI=mongodb://localhost:27017/it-helpdesk

# Auth — replace with your own long random strings in production
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Client
CLIENT_URL=http://localhost:5173

# Email — leave blank to use the Ethereal test account (emails are captured,
# preview links are printed to the console). Fill in to use real SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=IT Help Desk <no-reply@ithelpdesk.local>
